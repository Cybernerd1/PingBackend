# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CORS_ORIGIN=*

# ── Database (NeonDB / PostgreSQL) ────────────────────────
DATABASE_URL=postgresql://user:password@hostname/dbname?sslmode=require

# ── JWT ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_token_secret_min_64_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Firebase Admin (OTP verification) ────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ── Google OAuth (ID token verification) ─────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Cloudinary (photo + media uploads) ───────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Logging ───────────────────────────────────────────────
# LOG_LEVEL options: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Push notifications (FCM) ─────────────────────────────
# Firebase service-account JSON on ONE line (Firebase console → Project settings → Service accounts)
FIREBASE_SERVICE_ACCOUNT=

# ── Ping Assistant (OpenRouter) ──────────────────────────
# Without a key the assistant answers with built-in replies.
OPENROUTER_API_KEY=
# Any OpenRouter model id, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-haiku, meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://ping.app
